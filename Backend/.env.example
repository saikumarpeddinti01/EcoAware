# Copy this file to .env and fill in your own values. NEVER commit .env
PORT=5000
NODE_ENV=development

# Supabase -> Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxxxxxxx.supabase.co:5432/postgres

# Frontend URL allowed to call this API (your partners' dev server)
CLIENT_URL=http://localhost:5173

# ---- Auth ----
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# true  = reporters must verify email with a 6-digit code before login
# false = skip verification (handy while testing)
REQUIRE_EMAIL_VERIFICATION=true

# ---- Email (optional) ----
# If SMTP_HOST is empty, verification codes are printed in the server console
# (and returned as "devCode" in the signup response when NODE_ENV=development).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Eco Aware <no-reply@ecoaware.org>"

# ---- First management account (used by: npm run seed:admin) ----
SEED_ADMIN_EMAIL=manager@ecoaware.org
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMe123

# ---- Photo storage (Stage 3) ----
# "supabase" (default) uploads to Supabase Storage. "local" saves to ./uploads (offline dev only).
STORAGE_DRIVER=supabase
# Supabase -> Project Settings -> API. The service_role key is SECRET: backend only, never in the front end.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste_service_role_key_here
SUPABASE_BUCKET=report-photos
# Only used by the "local" driver to build image URLs
API_URL=http://localhost:5000/api
